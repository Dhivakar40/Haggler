          "catalog"
        ]
      }
    },
    "/v1/price-bands": {
      "get": {
        "description": "Resolves the most local trusted band: pincode cluster, then city, then seeded default. `scope` and `isSeededDefault` tell the client which one was used.",
        "operationId": "CatalogController_priceBand_v1",
        "parameters": [
          {
            "name": "city",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Chennai"
            }
          },
          {
            "name": "pincode",
            "required": false,
            "in": "query",
            "schema": {
              "example": "600042"
            }
          },
          {
            "name": "category",
            "required": true,
            "in": "query",
            "schema": {
              "example": "electrician"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A PriceBandDto"
          }
        },
        "summary": "Price band (min/median/max, integer paise) for a category and area",
        "tags": [
          "catalog"
        ]
      }
    },
    "/v1/auth/otp/send": {
      "post": {
        "operationId": "AuthController_send_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+91[6-9][0-9]{9}$"
                  }
                },
                "required": [
                  "phone"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Send a 6-digit code by SMS. Limits: 30 s between codes, 5/hour per phone, 20/hour per IP.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "AuthController_verify_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+91[6-9][0-9]{9}$"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "deviceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,64}$"
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "android",
                      "ios",
                      "web"
                    ]
                  }
                },
                "required": [
                  "phone",
                  "code",
                  "deviceId",
                  "platform"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Verify the code. Creates the account on first sign-in and returns a session.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200
                  },
                  "deviceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,64}$"
                  }
                },
                "required": [
                  "refreshToken",
                  "deviceId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Exchange a refresh token for a new pair. The old refresh token stops working.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
