{
  "name": "@haggler/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.unit.config.js && jest --config jest.integration.config.js --runInBand",
    "test:unit": "jest --config jest.unit.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi": "ts-node --transpile-only scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@haggler/shared": "workspace:^",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "jest": "^29",
    "prisma": "^6",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.2"
  }
}
