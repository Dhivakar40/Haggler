  @@index([callerUserId])
  @@index([calleeUserId])
  @@map("call_sessions")
}

// ---------------------------------------------------------------------------
// Phase 2: on-demand marketplace
// ---------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
  OTHER

  @@map("gender")
}

enum GenderPreference {
  ANY
  FEMALE
  MALE

  @@map("gender_preference")
}

enum Urgency {
  IMMEDIATE
  SCHEDULED

  @@map("urgency")
}

/// Job lifecycle (D3). Transitions are validated in code (job-state.ts) and recorded in job_events.
enum JobStatus {
  REQUESTED
  BROADCASTING
  MATCHED
  NEGOTIATING
  AGREED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED_BY_WORKER
  CONFIRMED_BY_CUSTOMER
  CANCELLED
  NO_SHOW_WORKER
  NO_SHOW_CUSTOMER
  DISPUTED
  REFUNDED
  /// D-087 (Phase Flow-Final): the Ranger has arrived, start-OTP/selfie/GPS check-in are done,
  /// and a line-itemised quote has been sent — waiting on the customer to accept or reject it.
  QUOTING
  /// D-087: the customer rejected the quote. Terminal, distinct from CANCELLED so the
  /// visit-fee-charged settlement is unambiguous in reporting (CANCELLED still means "no
  /// money moved", exactly as before).
  QUOTE_REJECTED
  /// D-087 (Sub-phase I): the Ranger paused mid-job to fetch parts. Resumes to IN_PROGRESS, or
  /// closes to CANCELLED (reject/parts-unavailable) with Job.closeReason explaining which.
  PAUSED_PARTS

  @@map("job_status")
}

enum MediaKind {
  PHOTO
  VOICE

  @@map("media_kind")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED

  @@map("media_status")
}

/// D-080 (A5): mid-job add-on proposals. A Ranger proposes a catalogue item; the customer must
/// approve it in the app before it counts toward the final price — no silent upcharging.
enum JobAddOnStatus {
  PROPOSED
  APPROVED
  DECLINED

  @@map("job_add_on_status")
}

/// D-080 (A4): "other"-category quotes. Each Ranger may send exactly one quote per request (no
/// counters); the customer picks one, which performs the match.
enum JobQuoteStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("job_quote_status")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
  EXPIRED

  @@map("offer_status")
}

enum PartyRole {
  CUSTOMER
  WORKER

  @@map("party_role")
}

enum JobPhotoKind {
  BEFORE
  AFTER
  /// D-087: captured at arrival, alongside the start OTP and GPS check-in. Matched against the
  /// Ranger's KYC selfie by an admin side-by-side review today (J2) — no automated face-match
  /// provider exists yet; see kyc selfie-match.provider.ts's stub.
  SELFIE

  @@map("job_photo_kind")
}

enum BroadcastResponse {
  PENDING
  ACCEPTED
  DECLINED
  TAKEN
  EXPIRED

  @@map("broadcast_response")
}

enum PaymentMethod {
  CASH
  UPI

  @@map("payment_method")
}

/// Phase 11 (D-076): replaces the flat BadgeTierName ladder. Ascending. BRONZE/SILVER/GOLD/
/// PLATINUM/DIAMOND keep their old names and relative order (now positions 4-8 of 9) so existing
/// data migrates by name, not by rebuilding anyone's progress; WOOD/STONE/COPPER are new entry
/// tiers below, LEGENDARY a new aspirational tier above.
enum LeagueTierName {
  WOOD
  STONE
  COPPER
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  LEGENDARY

  @@map("league_tier")
}

/// Phase 12 (D-077): the client-side mirror of LeagueTierName. Ascending, different names so the
/// two ladders are never confused in copy or logs.
enum ClientLeagueTierName {
  NEWCOMER
  REGULAR
  PREFERRED
  TRUSTED
  LOYAL
  ELITE
  CHAMPION
  PATRON
  LEGEND

  @@map("client_league_tier")
}

/// What the customer asked for. Address fields are a SNAPSHOT so later edits never change history.
model ServiceRequest {
  id                  String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String                               @map("customer_id") @db.Uuid
  categoryId          String                               @map("category_id") @db.Uuid
  description         String
  addressLine         String                               @map("address_line")
  city                String
  state               String
  pincode             String
  location            Unsupported("geography(Point,4326)")
  urgency             Urgency
  scheduledFor        DateTime?                            @map("scheduled_for") @db.Timestamptz(6)
  genderPreference    GenderPreference                     @default(ANY) @map("gender_preference")
  /// Price band shown to both parties, frozen when the request is created. Kept for historical
  /// reads of pre-D-080 requests; no longer used to decide a new job's price (see listedPricePaise).
  bandScope           PriceBandScope                       @map("band_scope")
  bandMinPaise        Int                                  @map("band_min_paise")
  bandMedianPaise     Int                                  @map("band_median_paise")
  bandMaxPaise        Int                                  @map("band_max_paise")
  /// D-080 (A3): the fixed price list entry resolved and frozen at request creation, so the price
  /// a customer saw when booking never shifts under them while Rangers are being broadcast to.
  /// Null only for the "other" category, which has no fixed price (A4: Rangers quote instead).
  listedPricePaise    Int?                                 @map("listed_price_paise")
  listedPriceCityTier CityTier?                            @map("listed_price_city_tier")
  /// True when listedPricePaise is a fixed inspection/visit charge (A2) rather than a full service
  /// price — the Ranger proposes add-ons from the catalogue once on site.
  isInspectionCharge  Boolean                              @default(false) @map("is_inspection_charge")
  createdAt           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  job      Job?
  media    RequestMedia[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("service_requests")
}

model Job {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId              String         @unique @map("request_id") @db.Uuid
  customerId             String         @map("customer_id") @db.Uuid
  workerId               String?        @map("worker_id") @db.Uuid
  status                 JobStatus      @default(REQUESTED)
  agreedPricePaise       Int?           @map("agreed_price_paise")
  /// Phase Commerce B2: the platform fee, frozen at the same moment as agreedPricePaise (same
  /// reasoning — a customer who saw a price must not have the fee shift under them either).
  /// Null until agreed. Total the customer owes is agreedPricePaise + platformFeePaise.
  platformFeePaise       Int?           @map("platform_fee_paise")
  /// Broadcast progress. The scheduler picks up jobs whose next_wave_at has passed.
  currentWave            Int            @default(0) @map("current_wave")
  /// Bumped by each re-broadcast so previously invited Rangers can be invited again.
  broadcastAttempt       Int            @default(1) @map("broadcast_attempt")
  /// Phase 9 (D-069): paid Rush fee OR an active Haggler Plus membership at request time. Skips
  /// straight to the widest broadcast radius in one wave instead of progressively expanding.
  isRush                 Boolean        @default(false) @map("is_rush")
  nextWaveAt             DateTime?      @map("next_wave_at") @db.Timestamptz(6)
  broadcastDeadline      DateTime?      @map("broadcast_deadline") @db.Timestamptz(6)
  genderPreferenceMet    Boolean?       @map("gender_preference_met")
  /// Arrival code: hashed for checking, encrypted so the customer's app can show it. D-091:
  /// length/TTL moved to MarketplaceConfig's job_code_length/job_code_ttl_seconds (was a fixed
  /// 4-digit code with no expiry); arrivalCodeExpiresAt null means "generated before D-091",
  /// treated as never-expiring for an in-flight job rather than retroactively invalidated.
  arrivalCodeHash        String?        @map("arrival_code_hash")
  arrivalCodeEnc         String?        @map("arrival_code_enc")
  arrivalCodeTries       Int            @default(0) @map("arrival_code_tries")
  arrivalCodeExpiresAt   DateTime?      @map("arrival_code_expires_at") @db.Timestamptz(6)
  arrivalVerifiedAt      DateTime?      @map("arrival_verified_at") @db.Timestamptz(6)
  /// D-087 (Phase Flow-Final): the completion OTP, same hash/encrypt pattern as the arrival
  /// code above, generated once in-app payment succeeds — entering it is what actually closes
  /// the job, so the customer confirms they got what they paid for before the Ranger leaves.
  /// D-091: gained the same expiry treatment as the arrival code.
  completionCodeHash     String?        @map("completion_code_hash")
  completionCodeEnc      String?        @map("completion_code_enc")
  completionCodeTries    Int            @default(0) @map("completion_code_tries")
  completionCodeExpiresAt DateTime?     @map("completion_code_expires_at") @db.Timestamptz(6)
  completionVerifiedAt   DateTime?      @map("completion_verified_at") @db.Timestamptz(6)
  /// Set once payment succeeds but the customer has not yet shared/entered the completion code —
  /// read by a scheduled job that auto-releases the Ranger's earnings after a configurable
  /// window (default 24h) unless a dispute is open.
  paidPendingCodeAt      DateTime?      @map("paid_pending_code_at") @db.Timestamptz(6)
  /// D-087: labour-only quote total once a JobQuote is accepted (parts/extra tracked on the
  /// quote itself, not duplicated here) — distinct from the legacy agreedPricePaise, which a
  /// pre-D-087 job still uses for its single listed price.
  acceptedQuoteId        String?        @map("accepted_quote_id") @db.Uuid
  /// D-087: PAUSED_PARTS bookkeeping (Sub-phase I). Extension count is capped
  /// (max_parts_extensions); pausedReturnBy is the Ranger's promised return time, read by the
  /// missed-slot reliability check.
  pausedAt               DateTime?      @map("paused_at") @db.Timestamptz(6)
  pausedReason           String?        @map("paused_reason")
  pausedExtensionCount   Int            @default(0) @map("paused_extension_count")
  pausedReturnBy         DateTime?      @map("paused_return_by") @db.Timestamptz(6)
  /// D-092 (I3): set once the Scheduler has pushed the "Ranger hasn't returned" reminder for the
  /// current pause, so it is sent once, not every tick; cleared on resume/the next pause/the
  /// customer acknowledging "I'll keep waiting."
  pausedOverdueNotifiedAt DateTime?      @map("paused_overdue_notified_at") @db.Timestamptz(6)
  /// D-092 (I2): the Ranger's proposed amount for work already done before a pause, shown to the
  /// customer when they reject the extension — in addition to the visit fee, not instead of it.
  /// Null means no proposal was made (the pre-D-092 behaviour: visit fee only).
  pauseSettlementPaise      Int?         @map("pause_settlement_paise")
  pauseSettlementBillPhotoId String?     @map("pause_settlement_bill_photo_id") @db.Uuid
  pauseSettlementProposedAt DateTime?    @map("pause_settlement_proposed_at") @db.Timestamptz(6)
  /// D-087: the frozen visit-fee amount once charged (quote rejection, or a paused-job closure
  /// that owes one) — null until charged. Distinct from platformFeePaise, which is the
  /// commission on a completed job's labour.
  visitFeePaise          Int?           @map("visit_fee_paise")
  visitFeeChargedAt      DateTime?      @map("visit_fee_charged_at") @db.Timestamptz(6)
  /// D-087: free-form tag read only for reporting/settlement branching when status is
  /// QUOTE_REJECTED or CANCELLED — e.g. 'QUOTE_REJECTED', 'EXTENSION_REJECTED',
  /// 'PARTS_UNAVAILABLE'. Never drives the state machine itself (job-state.ts does that).
  closeReason            String?        @map("close_reason")
  matchedAt              DateTime?      @map("matched_at") @db.Timestamptz(6)
  agreedAt               DateTime?      @map("agreed_at") @db.Timestamptz(6)
  enRouteAt              DateTime?      @map("en_route_at") @db.Timestamptz(6)
  arrivedAt              DateTime?      @map("arrived_at") @db.Timestamptz(6)
  startedAt              DateTime?      @map("started_at") @db.Timestamptz(6)
  completedByWorkerAt    DateTime?      @map("completed_by_worker_at") @db.Timestamptz(6)
  confirmedAt            DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy            String?        @map("cancelled_by")
  cancelReason           String?        @map("cancel_reason")
  /// Set when the Ranger had already travelled a meaningful distance (D3). Charged in Phase 3.
  cancellationFeeApplies Boolean        @default(false) @map("cancellation_fee_applies")
  paymentMethod          PaymentMethod? @map("payment_method")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  request         ServiceRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  match           JobMatch?
  broadcasts      RequestBroadcast[]
  offers          Offer[]
  addOns          JobAddOn[]
  quotes          JobQuote[]
  itemHandovers   ItemHandover[]
  payment         JobPayment?
  events          JobEvent[]
  photos          JobPhoto[]
  locations       JobLocation[]
  thread          ChatThread?
  shares          TrustedShare[]
  reviews         Review[]
  sosAlerts       SosAlert[]
  disputes        Dispute[]
  incidentReports IncidentReport[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([status, nextWaveAt])
  @@map("jobs")
}

/// The single accepted match per job. UNIQUE(job_id) is the database-level guarantee that two
/// Rangers can never both win, even if Redis fails or is bypassed (D3).
model JobMatch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String   @unique @map("job_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_matches")
}

model RequestBroadcast {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  wave        Int
  attempt     Int               @default(1)
  workerId    String            @map("worker_id") @db.Uuid
  distanceM   Int               @map("distance_m")
  score       Float
  response    BroadcastResponse @default(PENDING)
  sentAt      DateTime          @default(now()) @map("sent_at") @db.Timestamptz(6)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId, attempt])
  @@index([workerId, response])
  @@map("request_broadcasts")
}

model RequestMedia {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String      @map("owner_id") @db.Uuid
  requestId       String?     @map("request_id") @db.Uuid
  kind            MediaKind
  bucket          String
  storageKey      String      @unique @map("storage_key")
  contentType     String      @map("content_type")
  sizeBytes       Int         @map("size_bytes")
  durationSeconds Int?        @map("duration_seconds")
  status          MediaStatus @default(PENDING_UPLOAD)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([requestId])
  @@map("request_media")
}

model Offer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String      @map("job_id") @db.Uuid
  round       Int
  fromRole    PartyRole   @map("from_role")
  amountPaise Int         @map("amount_paise")
  /// True when the amount is outside the price band; both parties must explicitly confirm.
  outsideBand Boolean     @default(false) @map("outside_band")
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, round])
  @@index([status, expiresAt])
  @@map("offers")
}

/// D-080 (A5): a Ranger's mid-job proposal of a catalogue add-on. Name and price are snapshotted
/// at proposal time so a later price-list edit never silently changes what the customer agreed to.
model JobAddOn {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String         @map("job_id") @db.Uuid
  addOnId    String         @map("add_on_id") @db.Uuid
  name       String
  pricePaise Int            @map("price_paise")
  status     JobAddOnStatus @default(PROPOSED)
  proposedAt DateTime       @default(now()) @map("proposed_at") @db.Timestamptz(6)
  decidedAt  DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  job   Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  addOn PriceListAddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@map("job_add_ons")
}

/// D-080 (A4): a Ranger's one quote for an "other"-category request — no counters, no rounds.
/// The customer accepts one (performing the match) or declines it; UNIQUE(job_id, worker_id)
/// enforces "one quote per Ranger per request" at the database level.
/// D-087 (Phase Flow-Final): amountPaise/the single-shot "other"-category quote predates this —
/// kept as the still-used legacy shape for "other" (A4). A line-itemised quote (any category,
/// built after arrival/diagnosis) additionally populates servicePaise onward and gets child
/// JobQuoteItem rows; amountPaise alone (items empty) still means the old one-number quote.
model JobQuote {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId               String         @map("job_id") @db.Uuid
  workerId            String         @map("worker_id") @db.Uuid
  amountPaise         Int            @map("amount_paise")
  status              JobQuoteStatus @default(PENDING)
  /// Labour line-items total (floor/ceiling-checked against the price list).
  servicePaise        Int?           @map("service_paise")
  /// Parts pass-through total, billed at actual cost (no platform fee on this).
  partsPaise          Int            @default(0) @map("parts_paise")
  /// The small capped "extra" line (percent-of-labour capped, system_config
  /// quote_extra_cap_bps) plus its one-line description.
  extraPaise          Int            @default(0) @map("extra_paise")
  extraDescription    String?        @map("extra_description")
  /// Computed server-side, on servicePaise only — never entered by the Ranger or customer.
  feePaise            Int?           @map("fee_paise")
  /// servicePaise + partsPaise + extraPaise + feePaise, the number shown to the customer.
  totalPaise          Int?           @map("total_paise")
  /// True when any labour item in this quote exceeds its ceiling — allowed only with a photo +
  /// written reason (aboveCeilingPhotoId/aboveCeilingReason), still sent to the customer marked
  /// "above typical range", and queues the Ranger for admin review (flaggedForReview).
  aboveCeiling        Boolean        @default(false) @map("above_ceiling")
  aboveCeilingPhotoId String?        @map("above_ceiling_photo_id") @db.Uuid
  aboveCeilingReason  String?        @map("above_ceiling_reason")
  flaggedForReview    Boolean        @default(false) @map("flagged_for_review")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  job   Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items JobQuoteItem[]

  @@unique([jobId, workerId])
  @@index([jobId, status])
  @@map("job_quotes")
}

enum QuoteItemKind {
  LABOUR
  PART
  EXTRA

  @@map("quote_item_kind")
}

/// D-087: one line of a line-itemised JobQuote. `catalogItemId` is set for LABOUR (the admin
/// price-list item it came from, floor/ceiling-checked at that moment) and null for PART/EXTRA.
model JobQuoteItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String        @map("quote_id") @db.Uuid
  kind           QuoteItemKind
  catalogItemId  String?       @map("catalog_item_id") @db.Uuid
  name           String
  unitPricePaise Int           @map("unit_price_paise")
  quantity       Int           @default(1)
  totalPaise     Int           @map("total_paise")
  /// PART only: a photo of the purchase bill, required at submission.
  billPhotoId    String?       @map("bill_photo_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  quote JobQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("job_quote_items")
}

/// D-092 (Sub-phase I5): a record of a part the Ranger handed off-site for (e.g. taken to a
/// workshop for repair) while a job is PAUSED_PARTS — photo, description, where it went, when
/// it's expected back, and the customer's in-app sign-off that they agreed to the handover.
model ItemHandover {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
