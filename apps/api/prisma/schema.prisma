// Haggler foundation schema (Phase 0).
// Conventions:
//  - Table/column names are snake_case in the DB via @@map/@map.
//  - Money is integer paise. Never floats.
//  - Internal role name is WORKER; the UI calls it "Ranger" (docs/DECISIONS.md D-003).
//  - Geo columns use PostGIS `geography(Point,4326)`; Prisma can't model them, so they are
//    `Unsupported` and read/written with raw SQL. GIST indexes live in the raw SQL migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  CUSTOMER
  WORKER
  EMPLOYER
  STUDENT

  @@map("role_type")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED

  @@map("user_status")
}

enum PriceBandScope {
  PINCODE_CLUSTER
  CITY
  DEFAULT

  @@map("price_band_scope")
}

enum AdminRoleType {
  KYC_REVIEWER
  DISPUTE_AGENT
  FINANCE
  SUPER_ADMIN

  @@map("admin_role_type")
}

enum ActorType {
  ADMIN
  USER
  SYSTEM

  @@map("actor_type")
}

model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                String     @unique
  phoneVerifiedAt      DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  fullName             String?    @map("full_name")
  photoUrl             String?    @map("photo_url")
  preferredLanguage    String     @default("en") @map("preferred_language")
  languages            String[]   @default(["en"])
  status               UserStatus @default(ACTIVE)
  deletionRequestedAt  DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  deletionScheduledFor DateTime?  @map("deletion_scheduled_for") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles             UserRole[]
  devices           Device[]
  refreshTokens     RefreshToken[]
  addresses         Address[]
  workerProfile     WorkerProfile?
  emergencyContacts EmergencyContact[]
  consents          Consent[]
  kycChecks         KycCheck[]
  kycDocuments      KycDocument[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      RoleType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String    @map("device_id") // client-generated stable id (device binding)
  platform   String
  pushToken  String?   @map("push_token")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@map("devices")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. `familyId` groups a rotation
/// chain so reuse of an old token can revoke the whole family (theft detection).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceRefId  String?   @map("device_ref_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceRefId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String
  codeHash    String    @map("code_hash")
  ip          String?
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  failedTries Int       @default(0) @map("failed_tries")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@map("otp_attempts")
}

model Address {
  id        String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                                @map("user_id") @db.Uuid
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean                               @default(false) @map("is_default")
  /// geography(Point,4326); read/write via raw SQL (ST_MakePoint(lng, lat)).
  location  Unsupported("geography(Point,4326)")?
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

model ServiceCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  /// i18n key, e.g. "categories.electrician". The app translates it.
  nameKey         String   @map("name_key")
  icon            String
  requiresLicense Boolean  @default(false) @map("requires_license") // Tier 3 (D2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceBands       PriceBand[]
  workerCategories WorkerCategory[]
  requests         ServiceRequest[]

  @@map("service_categories")
}

model PriceBand {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String         @map("category_id") @db.Uuid
  scope         PriceBandScope
  city          String?
  /// First 3 digits of the PIN code (the "cluster"); only for scope PINCODE_CLUSTER.
  pincodePrefix String?        @map("pincode_prefix")
  minPaise      Int            @map("min_paise")
  medianPaise   Int            @map("median_paise")
  maxPaise      Int            @map("max_paise")
  /// Completed jobs the band was computed from. 0 means a seeded default.
  sampleSize    Int            @default(0) @map("sample_size")
  computedAt    DateTime       @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, scope])
  @@map("price_bands")
}

model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles      AdminRole[]
  kycReviews KycReview[]

  @@map("admin_users")
}

model AdminRole {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String        @map("admin_user_id") @db.Uuid
  role        AdminRoleType
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, role])
  @@map("admin_roles")
}

/// Append-only (enforced by a trigger in the migration: UPDATE/DELETE raise).
model AuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100) @map("rollout_percent")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_config")
}

/// Legal counsel must confirm every row before launch (docs/COMPLIANCE.md). Intentionally
/// NOT seeded: inventing wage numbers would be fake data.
model MinimumWageRule {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state             String
  tradeSlug         String   @map("trade_slug")
  dailyWagePaise    Int      @map("daily_wage_paise")
  effectiveFrom     DateTime @map("effective_from") @db.Date
  source            String?
  verifiedByCounsel Boolean  @default(false) @map("verified_by_counsel")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([state, tradeSlug, effectiveFrom])
  @@map("minimum_wage_rules")
}

// ---------------------------------------------------------------------------
// Phase 1: identity, consent, verification
// ---------------------------------------------------------------------------

enum KycDocumentType {
  AADHAAR_FRONT
  AADHAAR_BACK
  SELFIE
  ADDRESS_PROOF
  TRADE_LICENSE

  @@map("kyc_document_type")
}

enum KycDocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED

  @@map("kyc_document_status")
}

enum KycCheckStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED

  @@map("kyc_check_status")
}

enum KycDecision {
  APPROVE
  REJECT
  REQUEST_INFO

  @@map("kyc_decision")
}

enum ReferenceCallOutcome {
  NOT_CALLED
  VERIFIED
  NOT_REACHABLE
  NEGATIVE

  @@map("reference_call_outcome")
}

enum ConsentPurpose {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  KYC_PROCESSING

  @@map("consent_purpose")
}

/// The Ranger profile (internal name: worker). Created when a user adds the WORKER role.
model WorkerProfile {
  id              String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                                @unique @map("user_id") @db.Uuid
  /// 0 = unverified, 1 = identity verified, 2 = live-ready, 3 = licensed (category specific).
  kycTier         Int                                   @default(0) @map("kyc_tier")
  bio             String?
  experienceYears Int?                                  @map("experience_years")
  /// AES-256-GCM ciphertext (EncryptionService). Never store these in plaintext.
  aadhaarLast4Enc String?                               @map("aadhaar_last4_enc")
  dateOfBirthEnc  String?                               @map("date_of_birth_enc")
  /// Self-declared. Only used as a soft ranking bonus for customers who ask for a preference.
  gender          Gender?
  /// Presence: a Ranger counts as online only while lastLocationAt is fresh (heartbeat).
  isOnline        Boolean                               @default(false) @map("is_online")
  /// geography(Point,4326); raw SQL only.
  lastLocation    Unsupported("geography(Point,4326)")? @map("last_location")
  lastLocationAt  DateTime?                             @map("last_location_at") @db.Timestamptz(6)
  createdAt       DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories WorkerCategory[]

  @@map("worker_profiles")
}

model WorkerCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerProfileId String   @map("worker_profile_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workerProfile WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, categoryId])
  @@map("worker_categories")
}

model EmergencyContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

/// DPDP: explicit, purpose-specific, versioned consent. Withdrawal sets revoked_at.
model Consent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  purpose   ConsentPurpose
  version   String
  grantedAt DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz(6)
  ip        String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
}

model KycCheck {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  tier            Int
  /// 'manual_admin' today. A vendor name later, with no schema change (D-016).
  provider        String         @default("manual_admin")
  status          KycCheckStatus @default(DRAFT)
  /// Vendor reference (unused for manual review).
  rawRef          String?        @map("raw_ref")
  /// Reason/message shown to the Ranger after a reject or a request for more info.
  reviewerMessage String?        @map("reviewer_message")
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents KycDocument[]
  reviews   KycReview[]
  reference ProfessionalReference?

  @@index([status, submittedAt])
  @@index([userId])
  @@map("kyc_checks")
}

model KycDocument {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  kycCheckId  String            @map("kyc_check_id") @db.Uuid
  type        KycDocumentType
  bucket      String
  storageKey  String            @unique @map("storage_key")
  contentType String            @map("content_type")
  sizeBytes   Int?              @map("size_bytes")
  status      KycDocumentStatus @default(PENDING_UPLOAD)
  uploadedAt  DateTime?         @map("uploaded_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycCheck KycCheck @relation(fields: [kycCheckId], references: [id], onDelete: Cascade)

  @@index([kycCheckId])
  @@map("kyc_documents")
}

model KycReview {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kycCheckId  String      @map("kyc_check_id") @db.Uuid
  adminUserId String      @map("admin_user_id") @db.Uuid
  decision    KycDecision
  reason      String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  kycCheck  KycCheck  @relation(fields: [kycCheckId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([kycCheckId])
  @@map("kyc_reviews")
}

/// Tier 2: one professional reference per check; an admin logs the verification call.
model ProfessionalReference {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kycCheckId   String               @unique @map("kyc_check_id") @db.Uuid
  name         String
  phone        String
  relationship String
  callOutcome  ReferenceCallOutcome @default(NOT_CALLED) @map("call_outcome")
  callNotes    String?              @map("call_notes")
  calledAt     DateTime?            @map("called_at") @db.Timestamptz(6)
  calledBy     String?              @map("called_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  kycCheck KycCheck @relation(fields: [kycCheckId], references: [id], onDelete: Cascade)

  @@map("professional_references")
}

/// Masked-call sessions. Table only: the Exotel adapter is out of scope (D-019).
model CallSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Will reference jobs(id) once the jobs table exists (Phase 2).
  jobId        String?   @map("job_id") @db.Uuid
  callerUserId String    @map("caller_user_id") @db.Uuid
  calleeUserId String    @map("callee_user_id") @db.Uuid
  provider     String
  providerRef  String?   @map("provider_ref")
  status       String    @default("CREATED")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSecs Int?      @map("duration_secs")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([callerUserId])
  @@index([calleeUserId])
  @@map("call_sessions")
}

// ---------------------------------------------------------------------------
// Phase 2: on-demand marketplace
// ---------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
  OTHER

  @@map("gender")
}

enum GenderPreference {
  ANY
  FEMALE
  MALE

  @@map("gender_preference")
}

enum Urgency {
  IMMEDIATE
  SCHEDULED

  @@map("urgency")
}

/// Job lifecycle (D3). Transitions are validated in code (job-state.ts) and recorded in job_events.
enum JobStatus {
  REQUESTED
  BROADCASTING
  MATCHED
  NEGOTIATING
  AGREED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED_BY_WORKER
  CONFIRMED_BY_CUSTOMER
  CANCELLED
  NO_SHOW_WORKER
  NO_SHOW_CUSTOMER
  DISPUTED
  REFUNDED

  @@map("job_status")
}

enum MediaKind {
  PHOTO
  VOICE

  @@map("media_kind")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED

  @@map("media_status")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
  EXPIRED

  @@map("offer_status")
}

enum PartyRole {
  CUSTOMER
  WORKER

  @@map("party_role")
}

enum JobPhotoKind {
  BEFORE
  AFTER

  @@map("job_photo_kind")
}

enum BroadcastResponse {
  PENDING
  ACCEPTED
  DECLINED
  TAKEN
  EXPIRED

  @@map("broadcast_response")
}

enum PaymentMethod {
  CASH
  UPI

  @@map("payment_method")
}

enum BadgeTierName {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND

  @@map("badge_tier")
}

/// What the customer asked for. Address fields are a SNAPSHOT so later edits never change history.
model ServiceRequest {
  id               String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String                               @map("customer_id") @db.Uuid
  categoryId       String                               @map("category_id") @db.Uuid
  description      String
  addressLine      String                               @map("address_line")
  city             String
  state            String
  pincode          String
  location         Unsupported("geography(Point,4326)")
  urgency          Urgency
  scheduledFor     DateTime?                            @map("scheduled_for") @db.Timestamptz(6)
  genderPreference GenderPreference                     @default(ANY) @map("gender_preference")
  /// Price band shown to both parties, frozen when the request is created.
  bandScope        PriceBandScope                       @map("band_scope")
  bandMinPaise     Int                                  @map("band_min_paise")
  bandMedianPaise  Int                                  @map("band_median_paise")
  bandMaxPaise     Int                                  @map("band_max_paise")
  createdAt        DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  job      Job?
  media    RequestMedia[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("service_requests")
}

model Job {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId              String         @unique @map("request_id") @db.Uuid
  customerId             String         @map("customer_id") @db.Uuid
  workerId               String?        @map("worker_id") @db.Uuid
  status                 JobStatus      @default(REQUESTED)
  agreedPricePaise       Int?           @map("agreed_price_paise")
  /// Broadcast progress. The scheduler picks up jobs whose next_wave_at has passed.
  currentWave            Int            @default(0) @map("current_wave")
  /// Bumped by each re-broadcast so previously invited Rangers can be invited again.
  broadcastAttempt       Int            @default(1) @map("broadcast_attempt")
  nextWaveAt             DateTime?      @map("next_wave_at") @db.Timestamptz(6)
  broadcastDeadline      DateTime?      @map("broadcast_deadline") @db.Timestamptz(6)
  genderPreferenceMet    Boolean?       @map("gender_preference_met")
  /// 4-digit arrival code: hashed for checking, encrypted so the customer's app can show it.
  arrivalCodeHash        String?        @map("arrival_code_hash")
  arrivalCodeEnc         String?        @map("arrival_code_enc")
  arrivalCodeTries       Int            @default(0) @map("arrival_code_tries")
  arrivalVerifiedAt      DateTime?      @map("arrival_verified_at") @db.Timestamptz(6)
  matchedAt              DateTime?      @map("matched_at") @db.Timestamptz(6)
  agreedAt               DateTime?      @map("agreed_at") @db.Timestamptz(6)
  enRouteAt              DateTime?      @map("en_route_at") @db.Timestamptz(6)
  arrivedAt              DateTime?      @map("arrived_at") @db.Timestamptz(6)
  startedAt              DateTime?      @map("started_at") @db.Timestamptz(6)
  completedByWorkerAt    DateTime?      @map("completed_by_worker_at") @db.Timestamptz(6)
  confirmedAt            DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy            String?        @map("cancelled_by")
  cancelReason           String?        @map("cancel_reason")
  /// Set when the Ranger had already travelled a meaningful distance (D3). Charged in Phase 3.
  cancellationFeeApplies Boolean        @default(false) @map("cancellation_fee_applies")
  paymentMethod          PaymentMethod? @map("payment_method")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  request    ServiceRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  match      JobMatch?
  broadcasts RequestBroadcast[]
  offers     Offer[]
  events     JobEvent[]
  photos     JobPhoto[]
  locations  JobLocation[]
  thread     ChatThread?
  shares     TrustedShare[]
  reviews    Review[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([status, nextWaveAt])
  @@map("jobs")
}

/// The single accepted match per job. UNIQUE(job_id) is the database-level guarantee that two
/// Rangers can never both win, even if Redis fails or is bypassed (D3).
model JobMatch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String   @unique @map("job_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_matches")
}

model RequestBroadcast {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  wave        Int
  attempt     Int               @default(1)
  workerId    String            @map("worker_id") @db.Uuid
  distanceM   Int               @map("distance_m")
  score       Float
  response    BroadcastResponse @default(PENDING)
  sentAt      DateTime          @default(now()) @map("sent_at") @db.Timestamptz(6)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId, attempt])
  @@index([workerId, response])
  @@map("request_broadcasts")
}

model RequestMedia {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String      @map("owner_id") @db.Uuid
  requestId       String?     @map("request_id") @db.Uuid
  kind            MediaKind
  bucket          String
  storageKey      String      @unique @map("storage_key")
  contentType     String      @map("content_type")
  sizeBytes       Int         @map("size_bytes")
  durationSeconds Int?        @map("duration_seconds")
  status          MediaStatus @default(PENDING_UPLOAD)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([requestId])
  @@map("request_media")
}

model Offer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String      @map("job_id") @db.Uuid
  round       Int
  fromRole    PartyRole   @map("from_role")
  amountPaise Int         @map("amount_paise")
  /// True when the amount is outside the price band; both parties must explicitly confirm.
  outsideBand Boolean     @default(false) @map("outside_band")
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, round])
  @@index([status, expiresAt])
  @@map("offers")
}

model JobEvent {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String     @map("job_id") @db.Uuid
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  meta        Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_events")
}

model JobPhoto {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  uploaderId  String       @map("uploader_id") @db.Uuid
  kind        JobPhotoKind
  bucket      String
  storageKey  String       @unique @map("storage_key")
  contentType String       @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  status      MediaStatus  @default(PENDING_UPLOAD)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
  @@map("job_photos")
}

/// GPS trail while a job is active (D3). Retention is in docs/COMPLIANCE.md.
model JobLocation {
  id         String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String                               @map("job_id") @db.Uuid
  workerId   String                               @map("worker_id") @db.Uuid
  location   Unsupported("geography(Point,4326)")
  accuracyM  Float?                               @map("accuracy_m")
  recordedAt DateTime                             @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt  DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                             @default(now()) @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, recordedAt(sort: Desc)])
  @@map("job_locations")
}

model ChatThread {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @unique @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String   @map("thread_id") @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  body        String
  /// Client-generated id so a retried send after a dropped connection is not duplicated.
  clientMsgId String   @map("client_msg_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, senderId, clientMsgId])
  @@index([threadId, createdAt(sort: Desc), id])
  @@map("chat_messages")
}

/// Live trip link a customer can send to a trusted contact. Only the hash of the token is stored.
model TrustedShare {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("trusted_shares")
}

/// Blocked pairs never match (either direction, see presence.service.ts). User-facing endpoints
/// and mobile UI (block/unblock/list) are Phase 4 (reputation.module.ts).
model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model WorkerStats {
  workerUserId  String        @id @map("worker_user_id") @db.Uuid
  jobsCompleted Int           @default(0) @map("jobs_completed")
  badgeTier     BadgeTierName @default(BRONZE) @map("badge_tier")
  /// Sum and count, not a stored average: integer math avoids float drift (same reasoning as
  /// money), and the average is trivial to compute at read time (ratingSum / ratingCount).
  ratingSum     Int           @default(0) @map("rating_sum")
  ratingCount   Int           @default(0) @map("rating_count")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("worker_stats")
}

/// The customer-side mirror of WorkerStats (Phase 4): Rangers can rate customers too. Never shown
/// as prominently as a Ranger's own rating (customers aren't "hired"), but feeds a Ranger's own
/// judgement and, later, could gate a customer's ability to keep booking. No badge tier: badges are
/// a Ranger-facing trust signal only.
model CustomerStats {
  customerUserId String   @id @map("customer_user_id") @db.Uuid
  ratingSum      Int      @default(0) @map("rating_sum")
  ratingCount    Int      @default(0) @map("rating_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customer_stats")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: reviews, real badge-tier logic, and the Block feature's own endpoints (the matching
// engine has excluded blocked pairs since Phase 2 — see presence.service.ts — this phase adds the
// user-facing side of it).
// ---------------------------------------------------------------------------------------------

/// One review per (job, rater role): the customer can rate the Ranger, and the Ranger can rate the
/// customer, independently, only once each, only after the job is CONFIRMED_BY_CUSTOMER (the one
/// state that means the job genuinely happened and both parties agree on that).
model Review {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  raterId    String    @map("rater_id") @db.Uuid
  revieweeId String    @map("reviewee_id") @db.Uuid
  raterRole  PartyRole @map("rater_role")
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, raterRole])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ---------------------------------------------------------------------------------------------
// Phase 3: customer token wallet + Razorpay (test mode) top-ups.
//
// The platform NEVER touches job money: Rangers are paid cash/UPI, directly, in full, always
// (D-037). The wallet only holds TOKENS the customer buys, and one token is consumed only when a
// job reaches CONFIRMED_BY_CUSTOMER. A token is HELD (reserved, not yet spent) the moment a
// request is created, so a customer can never confirm more jobs than tokens they hold, and is
// RELEASED back if the job never completes. WalletHold has one row per job (unique job_id), so
// hold -> consume/release is race-safe the same way JobMatch/job_matches makes accept race-safe.
// ---------------------------------------------------------------------------------------------

enum WalletLedgerType {
  PURCHASE
  HOLD
  RELEASE
  CONSUME
  ADJUSTMENT

  @@map("wallet_ledger_type")
}

enum WalletHoldStatus {
  HELD
  CONSUMED
  RELEASED

  @@map("wallet_hold_status")
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED

  @@map("payment_order_status")
}

/// One row per customer. Created on first use (top-up or first request). balance_tokens is what
/// can still be spent; held_tokens is reserved against open jobs (see WalletHold).
model CustomerWallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  balanceTokens Int      @default(0) @map("balance_tokens")
  heldTokens    Int      @default(0) @map("held_tokens")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledger WalletLedgerEntry[]
  holds  WalletHold[]

  @@map("customer_wallets")
}

/// Append-only (DB trigger blocks UPDATE, same pattern as job_events). This is the audit trail;
/// CustomerWallet's counters are the fast-read cache, always kept in sync in the same transaction.
model WalletLedgerEntry {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId       String           @map("wallet_id") @db.Uuid
  type           WalletLedgerType
  /// Signed change to balance_tokens this entry caused. PURCHASE +N, HOLD -1, RELEASE +1,
  /// CONSUME 0 (a consume never touches balance, only held), ADJUSTMENT +/-N (admin correction).
  tokensDelta    Int              @map("tokens_delta")
  /// Signed change to held_tokens this entry caused: HOLD +1, RELEASE -1, CONSUME -1, others 0.
  /// Together with tokensDelta this makes every row a complete, replayable record of both buckets.
  heldDelta      Int              @default(0) @map("held_delta")
  jobId          String?          @map("job_id") @db.Uuid
  paymentOrderId String?          @map("payment_order_id") @db.Uuid
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("wallet_ledger_entries")
}

/// One row per job that has ever held a token. Unique(job_id) + the HELD-guarded update is what
/// makes consume/release idempotent even if two code paths race (e.g. scheduler auto-cancel and a
/// customer's manual cancel arriving together).
model WalletHold {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId  String           @map("wallet_id") @db.Uuid
  jobId     String           @unique @map("job_id") @db.Uuid
  tokens    Int              @default(1)
  status    WalletHoldStatus @default(HELD)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_holds")
}

/// A purchasable token bundle (SKU). A DB table, not hardcoded config, so bundles can change
/// without a deploy (mirrors PriceBand: catalog data, not application logic).
model TokenBundle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique
  name       String
  tokens     Int
  pricePaise Int      @map("price_paise")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders PaymentOrder[]

  @@map("token_bundles")
}

/// One row per top-up attempt. provider_payment_id is unique and only set once a payment is
/// actually captured, so a replayed webhook (or a client hitting verify twice) can never credit
/// the wallet twice for the same payment (D-039).
model PaymentOrder {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  bundleId          String             @map("bundle_id") @db.Uuid
  tokens            Int
  amountPaise       Int                @map("amount_paise")
  provider          String
  providerOrderId   String             @map("provider_order_id")
  providerPaymentId String?            @unique @map("provider_payment_id")
  status            PaymentOrderStatus @default(CREATED)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  failedReason      String?            @map("failed_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  bundle TokenBundle @relation(fields: [bundleId], references: [id])

  @@unique([provider, providerOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("payment_orders")
}
