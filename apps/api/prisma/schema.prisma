  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, recordedAt(sort: Desc)])
  @@map("job_locations")
}

enum SosAlertStatus {
  OPEN
  RESOLVED

  @@map("sos_alert_status")
}

/// D-080 (Sub-phase C): either party raises this during an active job. The other party is pushed
/// immediately; a DISPUTE_AGENT/SUPER_ADMIN sees it in a review queue (admin-sos.service.ts).
/// Reaching the triggering party's own emergency contacts is a client-side share (same pattern as
/// TrustedShare's live-trip link), not a server-sent SMS — this codebase has no SMS adapter.
model SosAlert {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String         @map("job_id") @db.Uuid
  triggeredBy String         @map("triggered_by") @db.Uuid
  role        PartyRole
  latitude    Float?
  longitude   Float?
  note        String?
  status      SosAlertStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  String?        @map("resolved_by") @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("sos_alerts")
}

enum DisputeStatus {
  OPEN
  RESOLVED

  @@map("dispute_status")
}

enum DisputeResolution {
  REFUND_CUSTOMER
  PAY_WORKER
  NO_ACTION
  /// D-087 (step 12): raised by the Ranger when a customer won't pay for finished work — the
  /// account is suspended (User.status) and the job carries no warranty.
  CUSTOMER_SUSPENDED

  @@map("dispute_resolution")
}

/// D-080 (Sub-phase D): raises the job into JobStatus.DISPUTED (D-076's state-machine edges, never
/// used until now — WorkerStats.jobsDisputed and the league dispute-rate formula were already
/// wired in for exactly this). The job itself (status, JobEvent trail, photos, GPS, JobPayment) IS
/// the evidence — this table only records who raised it, why, and the eventual decision. No money
/// moves automatically on REFUND_CUSTOMER: a real refund needs the same Razorpay-refund-API gap
/// flagged in D-081's token migration-plan report.
model Dispute {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId          String             @map("job_id") @db.Uuid
  raisedBy       String             @map("raised_by") @db.Uuid
  role           PartyRole
  reason         String
  status         DisputeStatus      @default(OPEN)
  resolution     DisputeResolution?
  resolutionNote String?            @map("resolution_note")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?            @map("resolved_by") @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status, createdAt])
  @@map("disputes")
}

enum IncidentReportReason {
  THEFT
  DAMAGE
  HARASSMENT
  DISCRIMINATION
  ACCIDENT
  OTHER

  @@map("incident_report_reason")
}

enum IncidentReportStatus {
  OPEN
  REVIEWING
  RESOLVED

  @@map("incident_report_status")
}

/// D-087 (Sub-phase J): a safety incident on a job, distinct from Dispute (money/quality) and
/// SosAlert (in-the-moment emergency) — this is a formal report reviewed with the job's own
/// trail as evidence (JobEvent, photos, GPS, chat). A credible report suspends the reported
/// person's account at once (User.status = SUSPENDED, already enforced on every request by
/// auth.guards.ts — nothing else needs to change for the suspension itself to take effect).
model IncidentReport {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String               @map("job_id") @db.Uuid
  reporterId      String               @map("reporter_id") @db.Uuid
  reporterRole    PartyRole            @map("reporter_role")
  reason          IncidentReportReason
  description     String
  status          IncidentReportStatus @default(OPEN)
  suspendedUserId String?              @map("suspended_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime?            @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?              @map("resolved_by") @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status, createdAt])
  @@map("incident_reports")
}

enum FraudSignalKind {
  /// Too many confirmed jobs in too short a window.
  VELOCITY
  /// A suspicious concentration of completed jobs between the same two accounts.
  REPEAT_PAIR
  /// A league promotion driven mostly by jobs below the minimum value to count as credible.
  LOW_VALUE

  @@map("fraud_signal_kind")
}

enum FraudReviewStatus {
  OPEN
  REVIEWING
  RESOLVED

  @@map("fraud_review_status")
}

/// D-093 (Sub-phase K1): a queued fraud signal — never anything that changes a balance or a
/// league by itself (FraudDetectionService only ever reads and writes rows here; every balance/
/// league change in this codebase still goes through its own existing, unrelated code path).
/// An admin reviewing this decides what, if anything, happens next using the existing dispute/
/// incident-report/suspension tools.
model FraudReviewItem {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          FraudSignalKind
  subjectUserId String            @map("subject_user_id") @db.Uuid
  relatedUserId String?           @map("related_user_id") @db.Uuid
  detail        Json
  status        FraudReviewStatus @default(OPEN)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedBy    String?           @map("resolved_by") @db.Uuid

  @@index([subjectUserId])
  @@index([status, createdAt])
  @@map("fraud_review_items")
}

model ChatThread {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @unique @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String   @map("thread_id") @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  body        String
  /// Client-generated id so a retried send after a dropped connection is not duplicated.
  clientMsgId String   @map("client_msg_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, senderId, clientMsgId])
  @@index([threadId, createdAt(sort: Desc), id])
  @@map("chat_messages")
}

/// Live trip link a customer can send to a trusted contact. Only the hash of the token is stored.
model TrustedShare {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("trusted_shares")
}

/// Blocked pairs never match (either direction, see presence.service.ts). User-facing endpoints
/// and mobile UI (block/unblock/list) are Phase 4 (reputation.module.ts).
model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model WorkerStats {
  workerUserId          String         @id @map("worker_user_id") @db.Uuid
  jobsCompleted         Int            @default(0) @map("jobs_completed")
  league                LeagueTierName @default(WOOD) @map("league")
  /// The highest league ever reached, distinct from `league` (today's, which can also drop). A
  /// league-up bonus pays only when `league` newly exceeds `highestLeague` — crossing the same
  /// boundary twice, or dropping and re-climbing back to a league already recorded here, never
  /// pays again (D-077 anti-farming/idempotency; retrofitted onto Part D's original logic, which
  /// had this exact gap).
  highestLeague         LeagueTierName @default(WOOD) @map("highest_league")
  /// Sum and count, not a stored average: integer math avoids float drift (same reasoning as
  /// money), and the average is trivial to compute at read time (ratingSum / ratingCount).
  ratingSum             Int            @default(0) @map("rating_sum")
  ratingCount           Int            @default(0) @map("rating_count")
  /// Jobs cancelled or no-showed by this worker (lifecycle.service.ts increments both at the
  /// same transition points that already end a job that way), feeding the league's cancellation
  /// rate factor.
  jobsCancelledByWorker Int            @default(0) @map("jobs_cancelled_by_worker")
  /// Reserved for a future dispute-raising feature (JobStatus.DISPUTED exists but nothing sets it
  /// yet, D-076): always 0 today. Wired into the league formula now so that feature needs zero
  /// scoring-side changes to plug in later — not a claim that dispute tracking is live.
  jobsDisputed          Int            @default(0) @map("jobs_disputed")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("worker_stats")
}

/// The customer-side mirror of WorkerStats (Phase 4): Rangers can rate customers too. Never shown
/// as prominently as a Ranger's own rating (customers aren't "hired"), but feeds a Ranger's own
/// judgement and, later, could gate a customer's ability to keep booking. No badge tier: badges are
/// a Ranger-facing trust signal only.
model CustomerStats {
  customerUserId              String               @id @map("customer_user_id") @db.Uuid
  ratingSum                   Int                  @default(0) @map("rating_sum")
  ratingCount                 Int                  @default(0) @map("rating_count")
  /// Phase 12 (D-077): the client league system. A booking counts only once a job reaches
  /// CONFIRMED_BY_CUSTOMER with a Ranger who was genuinely KYC-verified (kyc_tier >= 2) at that
  /// moment — the same anti-self-dealing guard documented on `lifecycle.service.ts`'s confirm().
  bookingsCompleted           Int                  @default(0) @map("bookings_completed")
  /// Bookings cancelled or no-showed BY this customer (mirrors WorkerStats.jobsCancelledByWorker).
  bookingsCancelledByCustomer Int                  @default(0) @map("bookings_cancelled_by_customer")
  league                      ClientLeagueTierName @default(NEWCOMER) @map("league")
  /// See WorkerStats.highestLeague: the high-water mark a league-up bonus is paid against, so a
  /// drop-and-reclimb or any other re-crossing of an already-reached league never pays twice.
  highestLeague               ClientLeagueTierName @default(NEWCOMER) @map("highest_league")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customer_stats")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: reviews, real badge-tier logic, and the Block feature's own endpoints (the matching
// engine has excluded blocked pairs since Phase 2 — see presence.service.ts — this phase adds the
// user-facing side of it).
// ---------------------------------------------------------------------------------------------

/// One review per (job, rater role): the customer can rate the Ranger, and the Ranger can rate the
/// customer, independently, only once each, only after the job is CONFIRMED_BY_CUSTOMER (the one
/// state that means the job genuinely happened and both parties agree on that).
model Review {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  raterId      String    @map("rater_id") @db.Uuid
  revieweeId   String    @map("reviewee_id") @db.Uuid
  raterRole    PartyRole @map("rater_role")
  rating       Int
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Phase 8 admin moderation (D-049): a hidden review is excluded from public review lists and
  /// its rating is reversed out of WorkerStats/CustomerStats (see AdminReviewsService.hide()).
  /// No `unhide` exists yet — hiding is a one-way moderation action for now (D-0xx known gap).
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenReason String?   @map("hidden_reason")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, raterRole])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ---------------------------------------------------------------------------------------------
// Phase 3: customer token wallet + Razorpay (test mode) top-ups.
//
// The platform NEVER touches job money: Rangers are paid cash/UPI, directly, in full, always
// (D-037). The wallet only holds TOKENS the customer buys, and one token is consumed only when a
// job reaches CONFIRMED_BY_CUSTOMER. A token is HELD (reserved, not yet spent) the moment a
// request is created, so a customer can never confirm more jobs than tokens they hold, and is
// RELEASED back if the job never completes. WalletHold has one row per job (unique job_id), so
// hold -> consume/release is race-safe the same way JobMatch/job_matches makes accept race-safe.
// ---------------------------------------------------------------------------------------------

enum WalletLedgerType {
  PURCHASE
  HOLD
  RELEASE
  CONSUME
  ADJUSTMENT
  /// The app paying the person (D-076 league-up rewards), never the reverse — distinct from
  /// ADJUSTMENT (a manual admin correction) so the ledger reads clearly on its own.
  BONUS

  @@map("wallet_ledger_type")
}

enum WalletHoldStatus {
  HELD
  CONSUMED
  RELEASED

  @@map("wallet_hold_status")
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED

  @@map("payment_order_status")
}

/// One row per customer. Created on first use (top-up or first request). balance_tokens is what
/// can still be spent; held_tokens is reserved against open jobs (see WalletHold).
model CustomerWallet {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  balanceTokens    Int      @default(0) @map("balance_tokens")
  heldTokens       Int      @default(0) @map("held_tokens")
  /// D-087 (H7): a one-way conversion target for a customer's remaining token balance once
  /// tokens stop being chargeable for anything (Phase Commerce, D-081) — non-withdrawable,
  /// usable only against this customer's future platform fee, drawn down automatically.
  /// Nothing converts into this yet (see admin-token-migration.service.ts); the field exists so
  /// the draw-down code has somewhere to read from once a conversion is run.
  promoCreditPaise Int      @default(0) @map("promo_credit_paise")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledger WalletLedgerEntry[]
  holds  WalletHold[]

  @@map("customer_wallets")
}

/// Append-only (DB trigger blocks UPDATE, same pattern as job_events). This is the audit trail;
/// CustomerWallet's counters are the fast-read cache, always kept in sync in the same transaction.
model WalletLedgerEntry {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId       String           @map("wallet_id") @db.Uuid
  type           WalletLedgerType
  /// Signed change to balance_tokens this entry caused. PURCHASE +N, HOLD -1, RELEASE +1,
  /// CONSUME 0 (a consume never touches balance, only held), ADJUSTMENT +/-N (admin correction).
  tokensDelta    Int              @map("tokens_delta")
  /// Signed change to held_tokens this entry caused: HOLD +1, RELEASE -1, CONSUME -1, others 0.
  /// Together with tokensDelta this makes every row a complete, replayable record of both buckets.
  heldDelta      Int              @default(0) @map("held_delta")
  jobId          String?          @map("job_id") @db.Uuid
  paymentOrderId String?          @map("payment_order_id") @db.Uuid
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("wallet_ledger_entries")
}

/// One row per job that has ever held a token. Unique(job_id) + the HELD-guarded update is what
/// makes consume/release idempotent even if two code paths race (e.g. scheduler auto-cancel and a
/// customer's manual cancel arriving together).
model WalletHold {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId  String           @map("wallet_id") @db.Uuid
  jobId     String           @unique @map("job_id") @db.Uuid
  tokens    Int              @default(1)
  status    WalletHoldStatus @default(HELD)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_holds")
}

/// A purchasable token bundle (SKU). A DB table, not hardcoded config, so bundles can change
/// without a deploy (mirrors PriceBand: catalog data, not application logic).
model TokenBundle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique
  name       String
  tokens     Int
  pricePaise Int      @map("price_paise")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders PaymentOrder[]

  @@map("token_bundles")
}

/// What a PaymentOrder is for (Phase 9, D-069). One order pipeline (create -> verify/sandbox-pay ->
/// webhook, all in WalletService), four purposes, dispatched in credit() by `purpose`. Every
/// purpose here is paid by a CUSTOMER or an EMPLOYER only — never a Ranger/student/contract worker
/// (D-037, unchanged; see the Phase 9 section of docs/DECISIONS.md for why this is enforced at the
/// order-creation call sites, not by a role column on this table).
enum PaymentPurpose {
  TOKEN_TOPUP
  PLUS_SUBSCRIPTION
  RUSH_FEE
  BOOSTED_LISTING
  /// Phase Commerce B3: an ONLINE job payment (service price + platform fee) at job completion.
  JOB_PAYMENT

  @@map("payment_purpose")
}

enum ListingKind {
  CONTRACT
  CAMPUS

  @@map("listing_kind")
}

/// One row per payment attempt, of any purpose. provider_payment_id is unique and only set once a
/// payment is actually captured, so a replayed webhook (or a client hitting verify twice) can never
/// apply the same payment twice (D-039). Exactly one of (bundleId, planId, targetJobId,
/// targetListingId) is set, matching `purpose` — enforced in WalletService.createXOrder(), not by a
/// DB constraint (Postgres CHECK across nullable FKs would need a trigger; not worth it for four
/// call sites that already can't set the wrong pair).
model PaymentOrder {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  purpose           PaymentPurpose     @default(TOKEN_TOPUP)
  bundleId          String?            @map("bundle_id") @db.Uuid
  tokens            Int?
  planId            String?            @map("plan_id") @db.Uuid
  targetJobId       String?            @map("target_job_id") @db.Uuid
  targetListingType ListingKind?       @map("target_listing_type")
  targetListingId   String?            @map("target_listing_id") @db.Uuid
  amountPaise       Int                @map("amount_paise")
  provider          String
  providerOrderId   String             @map("provider_order_id")
  providerPaymentId String?            @unique @map("provider_payment_id")
  status            PaymentOrderStatus @default(CREATED)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  failedReason      String?            @map("failed_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  bundle TokenBundle? @relation(fields: [bundleId], references: [id])
  plan   PlusPlan?    @relation(fields: [planId], references: [id])

  @@unique([provider, providerOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("payment_orders")
}

/// Phase Commerce B3/B4/B6: a Ranger's earnings and dues, replacing the token system's customer-
/// side wallet with the Ranger-side equivalent pay-after needs. `balancePaise` is withdrawable
/// online-job earnings (the fee already deducted before crediting); `duesPaise` is platform fee
/// owed from CASH jobs, where the Ranger collected the full amount and still owes the fee.
model WorkerWallet {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  balancePaise Int      @default(0) @map("balance_paise")
  duesPaise    Int      @default(0) @map("dues_paise")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledger WorkerWalletLedgerEntry[]

  @@map("worker_wallets")
}

enum WorkerWalletLedgerType {
  EARNING
  FEE_DUE
  DUES_SETTLED
  WITHDRAWAL
  ADJUSTMENT

  @@map("worker_wallet_ledger_type")
}

/// Append-only, same pattern as WalletLedgerEntry (customer side): the DB trigger blocking UPDATE
/// lives in the migration that creates this table.
model WorkerWalletLedgerEntry {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId    String                 @map("wallet_id") @db.Uuid
  type        WorkerWalletLedgerType
  amountPaise Int                    @map("amount_paise")
  jobId       String?                @map("job_id") @db.Uuid
  note        String?
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet WorkerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("worker_wallet_ledger_entries")
}

enum JobPaymentMode {
  CASH
  ONLINE

  @@map("job_payment_mode")
}

enum JobPaymentStatus {
  PENDING
  CONFIRMED
  MISMATCHED

  @@map("job_payment_status")
}

/// Phase Commerce B3: one row per job, created at job completion. CASH: the Ranger records what
/// they collected, the customer confirms it in the app; a mismatch is flagged (status
/// MISMATCHED), never silently resolved either direction, for admin review. ONLINE: a
/// PaymentOrder (purpose JOB_PAYMENT) drives it instead; status becomes CONFIRMED once that order
/// is PAID and the customer has confirmed completion.
model JobPayment {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId              String           @unique @map("job_id") @db.Uuid
  mode               JobPaymentMode
  servicePricePaise  Int              @map("service_price_paise")
  feePaise           Int              @map("fee_paise")
  totalPaise         Int              @map("total_paise")
  cashRecordedPaise  Int?             @map("cash_recorded_paise")
  cashConfirmedPaise Int?             @map("cash_confirmed_paise")
  status             JobPaymentStatus @default(PENDING)
  paymentOrderId     String?          @map("payment_order_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_payments")
}

/// A purchasable Haggler Plus plan (Phase 9). Customer plans and Employer plans are both rows here
/// (audience tells them apart) rather than two tables, same "one catalog table, a column narrows
/// it" shape as everything else purchasable in this schema (TokenBundle, PriceBand).
enum PlusAudience {
  CUSTOMER
  EMPLOYER

  @@map("plus_audience")
}

model PlusPlan {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String       @unique
  name             String
  audience         PlusAudience
  durationDays     Int          @map("duration_days")
  pricePaise       Int          @map("price_paise")
  /// Discount applied to token bundle prices while this plan is active, in basis points (1000 =
  /// 10% off). Computed live at quote/order time (WalletService), never stored per-bundle.
  tokenDiscountBps Int          @default(0) @map("token_discount_bps")
  isActive         Boolean      @default(true) @map("is_active")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders      PaymentOrder[]
  memberships PlusMembership[]

  @@map("plus_plans")
}

/// One row per user who has ever subscribed (cache of truth, same shape as CustomerWallet): a
/// renewal while still active extends expires_at from its current value rather than from now, so a
/// customer who renews early never loses the days they already paid for. "Active" is simply
/// `expires_at > now()`, checked live wherever it matters (bundle pricing, request-time rush) —
/// no separate status column or expiry job needed.
model PlusMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan PlusPlan @relation(fields: [planId], references: [id])

  @@map("plus_memberships")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: Contract labour (a job board, not on-demand dispatch — see docs/DECISIONS.md D-054).
// Money never moves through the app here: the employer pays the worker directly, same principle
// as Rangers never being charged (D-037). No geo column: listings are filtered by city/pincode
// text, not a radius search, so this phase needs no new raw-SQL/GIST migration edit.
// ---------------------------------------------------------------------------------------------

enum ContractPayType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
}

enum ContractListingStatus {
  OPEN
  PAUSED
  FILLED
  CLOSED
  CANCELLED
}

enum ContractApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

/// A light employer identity: a business name is all that is required to post a listing. No
/// document verification exists yet (D-054 known gap) — same placeholder status as Aadhaar
/// handling and price bands elsewhere in this project, not a claim that employers are vetted.
/// `verified` (Phase 7) gates Campus listings only — see D-062; Contract listings still need no
/// verification (D-056 known gap, deliberately not closed retroactively this phase).
model EmployerProfile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  businessName String    @map("business_name")
  /// An admin has confirmed this is a real business. Required before any Campus listing can be
  /// created (D-062). Never set by the employer themselves.
  verified     Boolean   @default(false)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings       ContractListing[]
  campusListings CampusListing[]

  @@map("employer_profiles")
}

model ContractListing {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerId     String                @map("employer_id") @db.Uuid
  categoryId     String                @map("category_id") @db.Uuid
  title          String
  description    String
  payType        ContractPayType       @map("pay_type")
  payAmountPaise Int                   @map("pay_amount_paise")
  /// How many people this listing will hire in total.
  openings       Int                   @default(1)
  /// Incremented on every HIRE decision; the listing auto-closes to FILLED once filled == openings.
  filledCount    Int                   @default(0) @map("filled_count")
  city           String
  state          String
  pincode        String
  startDate      DateTime?             @map("start_date") @db.Date
  status         ContractListingStatus @default(OPEN)
  /// Phase 9 (D-069): set by a paid Boosted Listing fee (WalletService). Browse surfaces every
  /// listing with boostedUntil > now() ahead of the normal newest-first list; read live, no
  /// separate expiry job needed.
  boostedUntil   DateTime?             @map("boosted_until") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz(6)

  employer     EmployerProfile       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category     ServiceCategory       @relation(fields: [categoryId], references: [id])
  applications ContractApplication[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([employerId, createdAt(sort: Desc)])
  @@map("contract_listings")
}

/// One row per (listing, worker). Re-applying after WITHDRAWN is allowed (flips the same row back
/// to APPLIED); re-applying after REJECTED or HIRED is not — the unique constraint plus that rule
/// (enforced in ApplicationsService, not the DB) means a worker has at most one live decision per
/// listing at a time.
model ContractApplication {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String                    @map("listing_id") @db.Uuid
  workerId  String                    @map("worker_id") @db.Uuid
  coverNote String?                   @map("cover_note")
  status    ContractApplicationStatus @default(APPLIED)
  appliedAt DateTime                  @default(now()) @map("applied_at") @db.Timestamptz(6)
  decidedAt DateTime?                 @map("decided_at") @db.Timestamptz(6)

  listing ContractListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  worker  User            @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([listingId, workerId])
  @@index([workerId, appliedAt(sort: Desc)])
  @@map("contract_applications")
}

// ---------------------------------------------------------------------------------------------
// Phase 7: Campus (part-time student jobs). Shares its mechanics and enums with Phase 6's
// Contract labour (same statuses, same job-board-not-dispatch shape, same no-money-through-the-
// app principle, D-054) but with Campus-specific safeguards the user required explicitly:
// a hard 18+ age gate (D-060), a weekly hours cap (D-061), a night-shift opt-in gate that also
// requires a verified employer (D-062), and employer verification as a prerequisite to posting
// at all (D-062). See docs/DECISIONS.md.
// ---------------------------------------------------------------------------------------------

/// A student's age is captured once, encrypted, and never re-enterable to a lower value once an
/// account exists below the cutoff (D-060: an under-18 signup is refused outright, no row is
/// created). Self-declared, not admin-reviewed like Ranger KYC (D-063 known gap) — the age gate
/// is still a hard block in code, not a checkbox someone can tick past.
model StudentProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  /// AES-256-GCM ciphertext (EncryptionService), same pattern as WorkerProfile.dateOfBirthEnc.
  dateOfBirthEnc String   @map("date_of_birth_enc")
  instituteName  String?  @map("institute_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CampusListing {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerId      String                @map("employer_id") @db.Uuid
  categoryId      String                @map("category_id") @db.Uuid
  title           String
  description     String
  hourlyRatePaise Int                   @map("hourly_rate_paise")
  /// Declared weekly commitment for this listing; summed against a student's other HIRED Campus
  /// jobs and checked against the configurable weekly cap (default 20 h, D-061) at apply and hire.
  hoursPerWeek    Int                   @map("hours_per_week")
  /// True if any shift overlaps 22:00-06:00. Creating one requires a verified employer (D-062);
  /// applying to one requires the student's explicit opt-in (CampusApplication.acceptsNightShift).
  isNightShift    Boolean               @default(false) @map("is_night_shift")
  openings        Int                   @default(1)
  filledCount     Int                   @default(0) @map("filled_count")
  city            String
  state           String
  pincode         String
  status          ContractListingStatus @default(OPEN)
  /// Phase 9 (D-069): same as ContractListing.boostedUntil.
  boostedUntil    DateTime?             @map("boosted_until") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt        DateTime?             @map("closed_at") @db.Timestamptz(6)

  employer     EmployerProfile     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category     ServiceCategory     @relation(fields: [categoryId], references: [id])
  applications CampusApplication[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([employerId, createdAt(sort: Desc)])
  @@map("campus_listings")
}

/// Mirrors ContractApplication's re-apply rule: only WITHDRAWN can be re-applied to, never
/// REJECTED or HIRED (D-058, same reasoning reused here).
model CampusApplication {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId         String                    @map("listing_id") @db.Uuid
  studentId         String                    @map("student_id") @db.Uuid
  coverNote         String?                   @map("cover_note")
  /// Required true to apply to a night-shift listing (D-062); meaningless (and ignored) otherwise.
  acceptsNightShift Boolean                   @default(false) @map("accepts_night_shift")
  status            ContractApplicationStatus @default(APPLIED)
  appliedAt         DateTime                  @default(now()) @map("applied_at") @db.Timestamptz(6)
  decidedAt         DateTime?                 @map("decided_at") @db.Timestamptz(6)

  listing CampusListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([listingId, studentId])
  @@index([studentId, appliedAt(sort: Desc)])
  @@map("campus_applications")
}
