{
  "expo": {
    "name": "Haggler",
    "slug": "haggler",
    "scheme": "haggler",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haggler.app"
    },
    "android": {
      "package": "com.haggler.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Haggler uses the camera to take your verification selfie and job photos.",
          "photosPermission": "Haggler reads photos you choose for verification and job requests."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haggler uses your location to fill in your address and to show where your Ranger is.",
          "locationAlwaysAndWhenInUsePermission": "Haggler shares your location with the customer while you are on an active job, even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Haggler records the voice note you attach to a request."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#0F766E"
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
