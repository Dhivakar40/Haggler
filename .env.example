# Copy to apps/api/.env for local development. NEVER commit real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Behind a load balancer set to the number of proxy hops so per-IP limits see real client IPs.
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://haggler:haggler_dev_pw@localhost:5433/haggler?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-0000
JWT_ACCESS_TTL_SECONDS=900
ADMIN_JWT_TTL_SECONDS=1800
REFRESH_TTL_DAYS=30
# Encrypts date of birth / Aadhaar last-4 at rest. 32 random bytes, base64. Losing it = losing that data.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLWhhZ2dsZXI=

# Global per-IP rate limit (requests per window)
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# Testing-only (D-074): accepts a fixed OTP ("123456") for any phone number, for teammates testing
# a standalone APK with no console to read a real sandbox OTP off of. Refused outright if
# NODE_ENV=production. Leave false/unset unless you mean it.
TESTING_MODE=false

# --- Object storage (MinIO locally; S3 or R2 in production) ---
S3_ENDPOINT=http://localhost:9000
# The host phones use to reach storage in presigned URLs. On a real phone set your PC's LAN IP.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=ap-south-1
S3_ACCESS_KEY=haggler
S3_SECRET_KEY=haggler_dev_pw
S3_BUCKET_MEDIA=haggler-media
S3_BUCKET_KYC=haggler-kyc
# In production enable bucket default encryption and set S3_SSE=AES256 (or aws:kms).
# S3_SSE=AES256

# --- Adapters (docs/DECISIONS.md D-016, D-019, D-020, D-021) ---
# sms: sandbox (OTP printed in this console) | live (MSG91)
SMS_MODE=sandbox
# kyc: manual admin review is the only implementation
KYC_PROVIDER=manual_admin
# payments: sandbox | test (Razorpay TEST keys only; there is no live mode)
PAYMENTS_MODE=sandbox
# calls: masked calling is out of scope for now
CALLS_MODE=disabled
# push: sandbox | live (FCM)
PUSH_MODE=sandbox
# maps: sandbox (no geocoding) | osm (OpenStreetMap Nominatim, needs NOMINATIM_USER_AGENT)
MAPS_MODE=sandbox

# --- Credentials for non-sandbox modes (leave empty in dev) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only signs sandbox top-ups; has a safe dev default and is never used when PAYMENTS_MODE=test.
# PAYMENTS_SANDBOX_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
SENTRY_DSN=

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
