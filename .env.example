# Copy to apps/api/.env for local development. NEVER commit real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://haggler:haggler_dev_pw@localhost:5433/haggler?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 1) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- Object storage (MinIO locally; S3 or R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=haggler
S3_SECRET_KEY=haggler_dev_pw
S3_BUCKET_MEDIA=haggler-media
S3_BUCKET_KYC=haggler-kyc

# --- Adapter modes: "sandbox" (fake, safe for dev/tests) or "live" (real vendor) ---
# The API logs the active mode of each adapter at startup and on /health/ready.
SMS_MODE=sandbox
KYC_MODE=sandbox
PAYMENTS_MODE=sandbox
CALLS_MODE=sandbox
PUSH_MODE=sandbox
MAPS_MODE=sandbox

# --- Live-mode credentials (leave empty in dev). Human action required to obtain. ---
MSG91_AUTH_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
